[sub_resource type="Resource" id="Resource_c53lw"]
script = ExtResource("1_hgese")
TextLine = "[typewriter]J'ai entendu dire que tu était sous OQTF.[/typewriter]"
metadata/_custom_type_script = "uid://bssgorv75yrf3"

[sub_resource type="Resource" id="Resource_6nx5x"]
script = ExtResource("1_hgese")
TextLine = "[typewriter]Mais je sens que tu n'as rien avoir dans l'histoire de DanDaDan dans la parodie de ReTake.[/typewriter]"
metadata/_custom_type_script = "uid://bssgorv75yrf3"

[sub_resource type="Resource" id="Resource_yf5nk"]
script = ExtResource("1_hgese")
TextLine = "[typewriter]Je me souviens que dedans t'avais 10 minutes pour sortir du tunnel de mémé.[/typewriter]"
metadata/_custom_type_script = "uid://bssgorv75yrf3"

[sub_resource type="Resource" id="Resource_w0lek"]
script = ExtResource("1_hgese")
TextLine = "[typewriter]Enfin, peu importe, est-ce que tu as des papiers de comment faire du chiffrement voire de l'encryptage de données par couplement d'or et de platine ?[/typewriter]"
metadata/_custom_type_script = "uid://bssgorv75yrf3"

